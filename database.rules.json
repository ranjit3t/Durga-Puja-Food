{
  "rules": {
    ".read": true,
    ".write": true,
    "appVersion": {
      ".read": true,
      ".write": true
    },
    "deprecatedVersion": {
      ".read": true,
      ".write": true
    },
    "androidAppLocation": {
      ".read": true,
      ".write": true
    },
    "iosAppLocation": {
      ".read": true,
      ".write": true
    },
    "auth_config": {
      ".read": true,
      ".write": true
    },
    "logs": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "notes": {
      ".read": true,
      ".write": true
    },
    "presence": {
      ".read": true,
      ".write": true,
      "$username": {
        ".write": true
      }
    },
    "chats": {
      ".read": true,
      ".write": true,
      "$chatId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["sender", "recipient", "timestamp"]
      }
    },
    "tenants": {
      ".read": true,
      ".write": true,
      "$tenantId": {
        ".read": true,
        ".write": true,
        "config": {
          ".read": true,
          ".write": true
        },
        "logs": {
          ".read": true,
          ".write": true,
          ".indexOn": ["timestamp"]
        },
        "seasons_data": {
          ".read": true,
          ".write": true,
          "$seasonCode": {
            ".read": true,
            ".write": true,
            "config": {
              ".read": true,
              ".write": true
            },
            "subscriptions": {
              ".read": true,
              ".indexOn": ["passcode", "block", "flat"],
              "$flatId": {
                ".read": true,
                ".write": true
              }
            },
            "menu": {
              ".read": true,
              ".write": true
            },
            "food_packages": {
              ".read": true,
              ".write": true
            },
            "caterer_finance": {
              ".read": true,
              ".write": true,
              ".indexOn": ["date", "type"]
            }
          }
        }
      }
    }
  }
}
